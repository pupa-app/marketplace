                "id" : "95434FCC-81EA-4234-81C2-36C2632383C0",
                "key" : "annual_savings",
                "kind" : {
                  "expression" : "monthly_contrib * 12",
                  "type" : "formula"
                },
                "name" : "Annual Savings",
                "unit" : "£"
              },
              {
                "format" : "%.1f",
                "id" : "DFF02E24-372F-414E-AB9F-7E38321CD395",
                "key" : "savings_rate",
                "kind" : {
                  "expression" : "annual_savings \/ income * 100",
                  "type" : "formula"
                },
                "name" : "Savings Rate",
                "unit" : "%"
              },
              {
                "format" : "%.2f",
                "id" : "5E649E63-215D-418C-BD2D-10E099CB99D8",
                "key" : "real_return",
                "kind" : {
                  "expression" : "return_rate - inflation",
                  "type" : "formula"
                },
                "name" : "Real Return (after inflation)",
                "unit" : "%"
              },
              {
                "id" : "921D1D6C-7C02-4FB1-B52E-528B675BA38E",
                "key" : "years_target",
                "kind" : {
                  "expression" : "target_age - current_age",
                  "type" : "formula"
                },
                "name" : "Years Until Target Age",
                "unit" : "yrs"
              },
              {
                "id" : "44688C61-D132-405B-8B42-F5C3E20A6C14",
                "key" : "fire_numbers",
                "kind" : {
                  "type" : "header"
                },
                "name" : "🎯 FIRE Numbers"
              },
              {
                "format" : "%.0f",
                "id" : "475B8D80-4D24-4631-95E4-A0F8546BEEC8",
                "key" : "fire_number",
                "kind" : {
                  "expression" : "expenses \/ (swr \/ 100)",
                  "type" : "formula"
                },
                "name" : "🔥 Regular FIRE Number",
                "unit" : "£"
              },
              {
                "format" : "%.0f",
                "id" : "76D4A222-7468-4483-AEB3-D37C55079F66",
                "key" : "lean_fire",
                "kind" : {
                  "expression" : "expenses * lean_mult \/ (swr \/ 100)",
                  "type" : "formula"
                },
                "name" : "🌱 Lean FIRE Number",
                "unit" : "£"
              },
              {
                "format" : "%.0f",
                "id" : "C14B447D-9349-49C0-A274-CC433ADB47B3",
                "key" : "fat_fire",
                "kind" : {
                  "expression" : "expenses * fat_mult \/ (swr \/ 100)",
                  "type" : "formula"
                },
                "name" : "🐳 Fat FIRE Number",
                "unit" : "£"
              },
              {
                "format" : "%.0f",
                "id" : "72CF01BD-281E-4A3B-BBB6-8E92D95108C2",
                "key" : "barista_fire",
                "kind" : {
                  "expression" : "(expenses - barista_income) \/ (swr \/ 100)",
                  "type" : "formula"
                },
                "name" : "☕ Barista FIRE Number",
                "unit" : "£"
              },
              {
                "format" : "%.0f",
                "id" : "DAEB5E15-44EF-4A15-86D0-F4422EF8DB89",
                "key" : "coast_fire",
                "kind" : {
                  "expression" : "fire_number \/ pow(1 + real_return \/ 100, years_target)",
                  "type" : "formula"
                },
                "name" : "🏄 Coast FIRE Number",
                "unit" : "£"
              },
              {
                "id" : "5C18145E-F485-4823-8BFA-3B8D6ADBDBAB",
                "key" : "your_progress",
                "kind" : {
                  "type" : "header"
                },
                "name" : "📈 Your Progress"
              },
              {
                "format" : "%.1f",
                "id" : "E5179A18-F2BB-47EE-809F-A37F374F923F",
                "key" : "progress_pct",
                "kind" : {
                  "expression" : "portfolio \/ fire_number * 100",
                  "type" : "formula"
                },
                "name" : "% Progress to Regular FIRE",
                "unit" : "%"
              },
              {
                "format" : "%.0f",
                "id" : "1E9935DA-4889-4CB8-BB64-7CEFFF92B5F1",
                "key" : "remaining",
                "kind" : {
                  "expression" : "fire_number - portfolio",
                  "type" : "formula"
                },
                "name" : "Remaining to Regular FIRE",
                "unit" : "£"
              },
              {
                "format" : "%.1f",
                "id" : "BCEA18E5-65C4-4FFA-A1E1-1C3EA9A0265D",
                "key" : "coast_pct",
                "kind" : {
                  "expression" : "portfolio \/ coast_fire * 100",
                  "type" : "formula"
                },
                "name" : "% Progress to Coast FIRE",
                "unit" : "%"
              },
              {
                "format" : "%.1f",
                "id" : "B33C7B17-91C2-4500-AC2A-D3C3B252439A",
                "key" : "yrs_to_fire",
                "kind" : {
                  "expression" : "log((fire_number * real_return \/ 100 + annual_savings) \/ (portfolio * real_return \/ 100 + annual_savings)) \/ log(1 + real_return \/ 100)",
                  "type" : "formula"
                },
                "name" : "Years to Regular FIRE",
                "unit" : "yrs"
              },
              {
                "format" : "%.0f",
                "id" : "98A6F5F5-6DB1-4146-BEEE-AD3E168F7DE4",
                "key" : "fire_age",
                "kind" : {
                  "expression" : "current_age + yrs_to_fire",
                  "type" : "formula"
                },
                "name" : "Projected FIRE Age",
                "unit" : "yrs"
              },
              {
                "id" : "B2EC2E5F-3DF6-488A-9112-319F5944B679",
                "key" : "growth_header",
                "kind" : {
                  "type" : "header"
                },
                "name" : "📉 Growth Projection"
              },
              {
                "id" : "8939EC59-5C7B-446A-9AAE-6B2D62A163A5",
                "key" : "proj_year",
                "kind" : {
                  "control" : {
                    "max" : 40,
                    "min" : 0,
                    "step" : 1,
                    "type" : "slider"
                  },
                  "type" : "variable",
                  "value" : 8
                },
                "name" : "Projection Year (chart driver)",
                "unit" : "yrs"
              },
              {
                "format" : "%.0f",
                "id" : "8C4A84C4-56C9-4C02-8DC2-8AC5032E8F89",
                "key" : "proj_balance",
                "kind" : {
                  "expression" : "portfolio * (1 + real_return\/100)^proj_year + annual_savings * (((1 + real_return\/100)^proj_year - 1) \/ (real_return\/100))",
                  "type" : "formula"
                },
                "name" : "Projected Portfolio",
                "unit" : "£"
              },
              {
